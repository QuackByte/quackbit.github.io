---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const features = [
  {
    glyph: '🎯',
    title: 'Goals your way',
    body: 'Measure a habit in minutes, repetitions, glasses, or pages — whatever fits the thing you are trying to do.',
  },
  {
    glyph: '🗓️',
    title: 'Any schedule',
    body: 'Pick exactly which days of the week a habit repeats. Weekdays, weekends, or any mix.',
  },
  {
    glyph: '⚡️',
    title: 'One-tap logging',
    body: 'Complete a habit, log part of it, and undo a slip in a single tap. Correct a past day when you forget.',
  },
  {
    glyph: '🏠',
    title: 'A widget that logs',
    body: 'Add +1 or complete a goal right from your Home Screen, iPad, or Mac desktop without opening the app.',
  },
  {
    glyph: '🌱',
    title: 'Streaks that are fair',
    body: 'A rest day never breaks your streak, and a 28-day consistency garden shows how the month actually went.',
  },
  {
    glyph: '🔒',
    title: 'Private by design',
    body: 'No account, no ads, no tracking. Your habits live on your devices and sync through your own private iCloud.',
  },
];
---

<Layout>
  <main id="main">
    <section class="hero wrap">
      <div>
        <span class="badge">✨ Coming to the App Store</span>
        <h1>Little bits.<br />Big change.</h1>
        <p class="lede">
          Quackbit is a small, playful habit tracker for iPhone, iPad, and Mac. Set gentle daily
          goals, log them in a tap, and watch the little wins add up.
        </p>
        <div class="cta">
          <span class="button">Coming soon to the App Store</span>
          <a class="button secondary" href={`${base}/privacy/`}>How your data is handled</a>
        </div>
        <p class="platforms">iPhone · iPad · Mac · Syncs with iCloud</p>
      </div>
      <div class="hero-art">
        <div class="phone">
          <img src={`${base}/images/iphone-today.png`} width="390" height="844" alt="Quackbit showing today's habits" />
        </div>
      </div>
    </section>

    <section id="features" class="wrap">
      <div class="section-head">
        <h2>Small enough to start. Good enough to repeat.</h2>
        <p>Everything a habit needs, and nothing it does not.</p>
      </div>
      <div class="features">
        {features.map((feature) => (
          <article class="card">
            <span class="glyph" aria-hidden="true">{feature.glyph}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="wrap">
      <div class="section-head">
        <h2>A look around</h2>
        <p>The same app, at home on every screen.</p>
      </div>
      <div class="shots">
        <figure>
          <img src={`${base}/images/iphone-today.png`} width="390" height="844" alt="Today view on iPhone" />
          <figcaption>Today</figcaption>
        </figure>
        <figure>
          <img src={`${base}/images/iphone-progress.png`} width="390" height="844" alt="Progress view on iPhone" />
          <figcaption>Your progress</figcaption>
        </figure>
      </div>
    </section>

    <section class="wrap">
      <div class="quote">
        <p>
          Your habits stay on your devices and sync through your own private iCloud database.
          There is no account to create, no advertising, and no analytics.
        </p>
      </div>
    </section>
  </main>
</Layout>
